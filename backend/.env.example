# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon.tech PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech:5432/planmorph_db?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production

# DigitalOcean Spaces Configuration
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=planmorph
DO_SPACES_REGION=us-east-1
DO_SPACES_CDN_URL=https://planmorph.nyc3.cdn.digitaloceanspaces.com

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
