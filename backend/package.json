{
  "name": "planmorph-backend",
  "version": "1.0.0",
  "description": "Backend for PlanMorph Plans Store",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node src/db/seed.ts",
    "db:setup": "npm run migrate && npm run seed",
    "migrate:extensions": "ts-node src/db/migrate-extensions.ts",
    "seed:extensions": "ts-node src/db/seed-extensions.ts",
    "db:setup:full": "npm run migrate && npm run seed && npm run migrate:extensions && npm run seed:extensions"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.454.0",
    "@aws-sdk/s3-request-presigner": "^3.454.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pino": "^8.16.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.9",
    "nodemon": "^3.0.1",
    "pino-pretty": "^10.2.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
